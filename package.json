{
  "name": "zhihui-campus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "智汇校园 · 一站式智慧校园服务平台（EdgeOne 全栈）",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src node-functions edge-functions tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:db": "node scripts/sql-smoke-m4.mjs && node scripts/integrity-check.mjs && node scripts/gap-check.mjs",
    "check:e2e": "node scripts/e2e-smoke.mjs",
    "check:docs": "node scripts/check-readme.mjs",
    "shots": "node scripts/make-readme-shots.mjs",
    "check": "npm run lint && npm test && npm run check:db && npm run check:e2e && npm run check:docs"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "bcryptjs": "^2.4.3",
    "dompurify": "^3.4.15",
    "element-plus": "^2.8.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-vue-next": "^1.0.0",
    "mysql2": "^3.11.0",
    "pinia": "^2.2.2",
    "vue": "^3.4.38",
    "vue-router": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^5.1.2",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^5.4.2",
    "vitest": "^3.2.7"
  }
}
