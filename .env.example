# 智汇校园 · 环境变量模板
# 复制为 .env 后填入真实值。**不要提交 .env**（已在 .gitignore）。
#
# 说明文档：
#   数据库 / 部署  → docs/HANDOVER.md
#   邮件服务       → docs/MAIL-API.md
#   AI 能力        → docs/AI-FEATURES.md

# ---------- 数据库（TiDB Cloud，需 TLS）----------
DB_HOST=
DB_PORT=4000
DB_USER=
DB_PASSWORD=
DB_NAME=zhihui_campus
# TiDB Cloud 的 CA 证书路径（本地文件或 base64，见 lib/db.js）
DB_CA_PATH=

# ---------- 鉴权 ----------
# 必须是足够长的随机串；更换后所有已签发令牌立即失效
JWT_SECRET=

# ---------- 邮件服务（LanQin Email，详见 docs/MAIL-API.md）----------
# 开放 API 的 Token（lq_ 开头）。生产建议单独建一把只含
# messages:send + messages:read 的 Token，不要复用 admin 全权限 Token。
LANQIN_API_KEY=
# 实例地址（自建，固定）
LANQIN_BASE_URL=https://email.9o.pw
# 默认域名 ID（createMailbox 不指定域名时用它）
LANQIN_DOMAIN_ID=
# 系统发信邮箱 ID（验证码、告警邮件的发件人）
LANQIN_SEND_MAILBOX_ID=
# 发信邮箱的回退值（上面为空时用它）
LANQIN_SYSTEM_MAILBOX_ID=
# 邮件正文里展示的发件地址
LANQIN_SYSTEM_ADDRESS=system@keaidang.com
# 新建邮箱必须归属的用户 ID。**不填会导致发信 404**（邮箱不属于 Token 拥有者）
LANQIN_OWNER_USER_ID=

# ---------- AI 能力（可选，缺失时相关功能自动降级）----------
# 当前实际使用哪一种：glm / qwen
AI_PROVIDER=qwen
AI_GLM_API_KEY=
AI_GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
AI_GLM_MODEL=glm-4-flash
AI_QWEN_API_KEY=
AI_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_QWEN_MODEL=qwen-plus

# ---------- 端到端测试（可选）----------
E2E_ADMIN_PWD=
